{
  "appId": "app.margins.reader",
  "appName": "Margins",
  "webDir": "dist",
  "backgroundColor": "#f5f7f9",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css"
    },
    "BackgroundRunner": {
      "label": "app.margins.reader.check",
      "src": "runners/background.js",
      "event": "checkLibraries",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}